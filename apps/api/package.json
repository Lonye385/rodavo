{
  "name": "rodavo-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "./node_modules/.bin/prisma generate",
    "db:migrate": "./node_modules/.bin/prisma migrate dev",
    "db:push": "./node_modules/.bin/prisma db push",
    "seed:owner": "tsx src/scripts/seed_owner.ts",
    "import:hazards": "tsx src/scripts/import_hazards.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.16.1",
    "argon2": "^0.44.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "nanoid": "^5.1.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prisma": "6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
