generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  username     String   @unique
  role         Role     @default(user)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  posts        Post[]
  memberships  GuildMember[]
  guildMessages GuildMessage[]
  hazardReports HazardReport[]
  tickets      Ticket[]
  ticketMessages TicketMessage[]
  wallet       Wallet?
  ledgerEntries LedgerEntry[]
}

enum Role {
  user
  support
  moderator
  finance
  admin
  owner
}

model Session {
  id          String   @id
  userId      String
  refreshJti  String   @unique
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Post {
  id        String   @id
  userId    String
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Guild {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())

  members   GuildMember[]
  messages  GuildMessage[]
}

model GuildMember {
  id        String   @id
  userId    String
  guildId   String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  guild     Guild    @relation(fields: [guildId], references: [id])

  @@unique([userId, guildId])
  @@index([guildId])
}

model GuildMessage {
  id        String   @id
  guildId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([guildId, createdAt])
}

model AdminInvite {
  id         String   @id
  email      String
  role       Role
  token      String   @unique
  invitedBy  String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id        String   @id
  actorId   String?
  action    String
  target    String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum HazardType {
  fixedRadar
  mobileRadar
  police
  accident
  works
  danger
  redLight
  sectionControl
}

model HazardEvent {
  id          String     @id
  type        HazardType
  lat         Float
  lng         Float
  countryCode String?
  title       String?
  speedKph    Int?
  directionDeg Int?
  isActive    Boolean    @default(true)
  isStatic    Boolean    @default(false)
  source      String?
  expiresAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reports     HazardReport[]

  @@index([isActive])
  @@index([type, isActive])
  @@index([expiresAt])
}

model HazardReport {
  id        String   @id
  userId    String
  eventId   String
  kind      String   @default("report")
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  event     HazardEvent @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
}

enum TicketStatus {
  open
  pending
  closed
}

model Ticket {
  id        String       @id
  userId    String
  subject   String
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id])
  messages  TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId, createdAt])
}

model TicketMessage {
  id        String   @id
  ticketId  String
  userId    String?
  author    String   // 'user' | 'support' | 'system'
  text      String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

enum VehicleCategory {
  car
  moto
  bicycle
  truck
  bus
  rv
  tvde
}

model VehicleCatalogItem {
  id        String          @id
  category  VehicleCategory
  make      String
  model     String
  year      Int?
  // logistics specs
  heightM   Float?
  widthM    Float?
  lengthM   Float?
  weightT   Float?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([category, isActive])
}

model ShopPackage {
  id          String   @id
  sku         String   @unique
  title       String
  description String?
  priceEur    Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Promotion {
  id         String   @id
  code       String   @unique
  percentOff Int      @default(0)
  active     Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())
}

model Wallet {
  userId    String  @id
  cash      Int     @default(0)
  rCoins    Int     @default(0)
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id])
}

enum LedgerCurrency {
  cash
  rCoins
}

model LedgerEntry {
  id        String        @id
  userId    String
  currency  LedgerCurrency
  delta     Int
  reason    String
  metaJson  String?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
